    {
      "id": "p-rust-cve-2024-24576-linux",
      "product": "revera",
      "category": "security-advisory-conditions",
      "trap": true,
      "difficulty": "medium",
      "question": "A Linux-only Rust service built with Rust 1.76 passes user-controlled arguments to std::process::Command::new(\"git\").args(...). Is it affected by CVE-2024-24576?",
      "query": "CVE-2024-24576 Rust std::process::Command affected platforms",
      "gold_facts": [
        {
          "id": "windows-only",
          "text": "The vulnerability only concerns invoking batch files (.bat/.cmd) on Windows; no other platform or use is affected, so a Linux service is not affected.",
          "load_bearing": true,
          "patterns": [
            [
              "no other platform"
            ],
            [
              "only[^.]{0,80}windows"
            ],
            [
              "windows[^.]{0,30}only"
            ]
          ]
        },
        {
          "id": "fixed-version",
          "text": "Fixed in Rust 1.77.2.",
          "load_bearing": false,
          "patterns": [
            [
              "1\\.77\\.2"
            ]
          ]
        }
      ],
      "acceptable_sources": [
        {
          "url": "https://blog.rust-lang.org/2024/04/09/cve-2024-24576/"
        },
        {
          "url": "https://github.com/rust-lang/rust/security/advisories/GHSA-q455-m56c-85mh"
        },
        {
          "url": "https://nvd.nist.gov/vuln/detail/CVE-2024-24576"
        }
      ],
      "excerpts": [
        {
          "url": "https://blog.rust-lang.org/2024/04/09/cve-2024-24576/",
          "quote": "The severity of this vulnerability is critical if you are invoking batch files on Windows with untrusted arguments. No other platform or use is affected."
        }
      ],
      "negative_conditions": "Answering 'affected' because Command::args is used would be a false positive.",
      "checked_at": "2026-10-19"
    },
    {
      "id": "p-express5-wildcard",
      "product": "opencode",
      "category": "migration",
      "trap": false,
      "difficulty": "easy",
      "question": "After upgrading to Express 5, a catch-all route app.get('/*', handler) no longer works. What path syntax should replace it, and how do you also match the root path?",
      "query": "Express 5 migration wildcard route /* path syntax",
      "gold_facts": [
        {
          "id": "named-wildcard",
          "text": "The wildcard must be named: use '/*splat' instead of '/*'.",
          "load_bearing": true,
          "patterns": [
            [
              "\\*splat"
            ],
            [
              "wildcard[^.]{0,40}must have a name"
            ]
          ]
        },
        {
          "id": "root-braces",
          "text": "Use '/{*splat}' to also match the root path.",
          "load_bearing": false,
          "patterns": [
            [
              "\\{\\*splat\\}"
            ]
          ]
        }
      ],
      "acceptable_sources": [
        {
          "url": "https://expressjs.com/en/guide/migrating-5.html"
        },
        {
          "url": "https://github.com/expressjs/express/releases/tag/v5.0.0"
        }
      ],
      "excerpts": [
        {
          "url": "https://expressjs.com/en/guide/migrating-5.html",
          "quote": "The wildcard * must have a name, matching the behavior of parameters"
